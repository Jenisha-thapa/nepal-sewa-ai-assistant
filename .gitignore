# Environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets
.env

# Fetched/generated data — raw government content and processed indices
# shouldn't live in git history; keep the repo to code + config.
data/raw/*
data/processed/*
data/index/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/index/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS/editor cruft
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

nul
