# Environment Configuration
# Copy this to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openai, anthropic, ollama, openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAM_MODEL=llama3

# OpenRouter (required if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./data/nepal_rag.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/nepal_rag

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:7860

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Nepal Government Services RAG
APP_DESCRIPTION=Ask questions about Nepal government public services in Nepali or English
APP_VERSION=1.0.0
